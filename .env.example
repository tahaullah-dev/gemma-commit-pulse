# ---- Required for AI mode ----
# Get a key at https://aistudio.google.com/apikey
GEMMA_API_KEY=

# Primary model. Set to your Gemma 4 model id when available,
# e.g. gemma-4-27b-it
GEMMA_MODEL=gemma-3-27b-it

# Comma-separated fallbacks tried in order if the primary fails
GEMMA_FALLBACK_MODELS=gemma-3-27b-it,gemini-2.0-flash

# ---- Tuning (optional) ----
MAX_DIFF_CHARS=120000
MAX_OUTPUT_TOKENS=4096
TEMPERATURE=0.2
REQUEST_TIMEOUT=60
DB_PATH=data/pulse.db
HISTORY_LIMIT=25